# Copy to .env for local development.
# NEVER commit .env or real credentials.

# App
APP_ENV=development
APP_NAME=ourapp

# Backend
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Supabase (Backend)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase (Frontend Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Redis
REDIS_URL=redis://redis:6379/0

# Instagram / Meta Configuration (Server-only)
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_BOT_USERNAME=save.this.for.me

# Feature Flags
INSTAGRAM_POST_CAPTURE_ENABLED=false

# AI / media providers (Future phases)
AI_PROVIDER=
AI_API_KEY=

# Optional observability
SENTRY_DSN=
